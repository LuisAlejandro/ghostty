using Gtk 4.0;
using Adw 1;

template $GhosttyWindow: Adw.ApplicationWindow {
  styles [
    "window",
  ]

  close-request => $close_request();
  realize => $realize();
  notify::config => $notify_config();
  notify::fullscreened => $notify_fullscreened();
  notify::is-active => $notify_is_active();
  notify::maximized => $notify_maximized();
  notify::scale-factor => $notify_scale_factor();
  default-width: 800;
  default-height: 600;
  // GTK4 grabs F10 input by default to focus the menubar icon. We want
  // to disable this so that terminal programs can capture F10 (such as htop)
  handle-menubar-accel: false;

  content: Adw.TabOverview tab_overview {
    notify::open => $overview_notify_open();
    view: tab_view;
    // Disable the title buttons (close, maximize, minimize, ...)
    // *inside* the tab overview if CSDs are disabled.
    // We do spare the search button, though.
    show-start-title-buttons: bind template.decorated;
    show-end-title-buttons: bind template.decorated;

    Adw.ToolbarView toolbar {
      top-bar-style: bind template.toolbar-style;
      bottom-bar-style: bind template.toolbar-style;

      [top]
      Adw.HeaderBar {
        visible: bind template.headerbar-visible;

        title-widget: Adw.WindowTitle {
          title: bind $computed_title(template.config, template.title, template.title-override) as <string>;
          // Blueprint auto-formatter won't let me split this into multiple
          // lines. Let me explain myself. All parameters to a closure are used
          // as notifications to recompute the value of the closure. All
          // elements of a property chain are also subscribed to for changes.
          // This one long, ugly line saves us from manually building up this
          // massive notify chain in code.
          subtitle: bind $computed_subtitle(
            template.config,
            tab_view.selected-page.child as <$GhosttyTab>.active-surface as <$GhosttySurface>.pwd
            ) as <string>;
        };

        [end]
        Gtk.Box {
          Gtk.MenuButton main_menu_button {
            notify::active => $notify_menu_active();
            icon-name: "open-menu-symbolic";
            menu-model: main_menu;
            tooltip-text: _("Main Menu");
            can-focus: false;
          }
        }
      }

      Box {
        orientation: vertical;

        $GhosttyDebugWarning {
          visible: bind template.debug;
        }

        Adw.ToastOverlay toast_overlay {
          Adw.TabView tab_view {
            notify::n-pages => $notify_n_pages();
            notify::selected-page => $notify_selected_page();
            close-page => $close_page();
            page-attached => $page_attached();
            page-detached => $page_detached();
            create-window => $tab_create_window();
            shortcuts: none;
          }
        }
      }
    }
  };
}

menu main_menu {
  section {
    item {
      label: _("Copy");
      action: "win.copy";
    }

    item {
      label: _("Paste");
      action: "win.paste";
    }
  }

  section {
    item {
      label: _("Close Window");
      action: "win.close";
    }
  }

  section {
    item {
      label: _("Clear");
      action: "win.clear";
    }

    item {
      label: _("Reset");
      action: "win.reset";
    }
  }

  // Mash: Herdr commands. Each item sends its shipped Linux Herdr chord to
  // this window's terminal (win.mash-send-key -> mash_send_key), so it
  // behaves exactly like the shortcut. accel only displays the chord.
  section {
    submenu {
      label: _("File");

      section {
        item {
          label: _("New Dev Tab");
          action: "win.mash-send-key";
          target: "ctrl+alt+t";
          accel: "<Control><Alt>t";
        }

        item {
          label: _("New Agent Tab");
          action: "win.mash-send-key";
          target: "ctrl+alt+shift+t";
          accel: "<Control><Alt><Shift>t";
        }

        item {
          label: _("New Review Tab");
          action: "win.mash-send-key";
          target: "ctrl+shift+r";
          accel: "<Control><Shift>r";
        }

        item {
          label: _("New Shell Tab");
          action: "win.mash-send-key";
          target: "ctrl+shift+t";
          accel: "<Control><Shift>t";
        }
      }

      section {
        item {
          label: _("New Workspace…");
          action: "win.mash-send-key";
          target: "ctrl+alt+shift+n";
          accel: "<Control><Alt><Shift>n";
        }

        item {
          label: _("New Worktree…");
          action: "win.mash-send-key";
          target: "ctrl+alt+shift+e";
          accel: "<Control><Alt><Shift>e";
        }

        item {
          label: _("Workspace Picker…");
          action: "win.mash-send-key";
          target: "ctrl+alt+shift+o";
          accel: "<Control><Alt><Shift>o";
        }
      }

      section {
        item {
          label: _("Close Pane");
          action: "win.mash-send-key";
          target: "ctrl+alt+w";
          accel: "<Control><Alt>w";
        }

        item {
          label: _("Close Tab");
          action: "win.mash-send-key";
          target: "ctrl+shift+w";
          accel: "<Control><Shift>w";
        }

        item {
          label: _("Close Workspace");
          action: "win.mash-send-key";
          target: "ctrl+alt+shift+w";
          accel: "<Control><Alt><Shift>w";
        }

        item {
          label: _("Remove Worktree");
          action: "win.mash-send-key";
          target: "ctrl+alt+shift+backspace";
          accel: "<Control><Alt><Shift>BackSpace";
        }
      }
    }

    submenu {
      label: _("Edit");

      section {
        item {
          label: _("Annotate Selection");
          action: "win.mash-send-key";
          target: "ctrl+alt+k";
          accel: "<Control><Alt>k";
        }

        item {
          label: _("Paste Annotations into Agent");
          action: "win.mash-send-key";
          target: "ctrl+alt+l";
          accel: "<Control><Alt>l";
        }

        item {
          label: _("Manage Annotations");
          action: "win.mash-send-key";
          target: "ctrl+shift+l";
          accel: "<Control><Shift>l";
        }
      }

      section {
        item {
          label: _("Pick Link or ID");
          action: "win.mash-send-key";
          target: "alt+g";
          accel: "<Alt>g";
        }
      }
    }

    submenu {
      label: _("View");

      section {
        item {
          label: _("Toggle Sidebar");
          action: "win.mash-send-key";
          target: "ctrl+alt+b";
          accel: "<Control><Alt>b";
        }

        item {
          label: _("Zoom Pane");
          action: "win.mash-send-key";
          target: "ctrl+alt+z";
          accel: "<Control><Alt>z";
        }
      }

      section {
        item {
          label: _("Split Pane Right");
          action: "win.mash-send-key";
          target: "ctrl+alt+backslash";
          accel: "<Control><Alt>backslash";
        }

        item {
          label: _("Split Pane Down");
          action: "win.mash-send-key";
          target: "ctrl+alt+minus";
          accel: "<Control><Alt>minus";
        }

        item {
          label: _("Resize Mode");
          action: "win.mash-send-key";
          target: "ctrl+alt+r";
          accel: "<Control><Alt>r";
        }
      }
    }

    submenu {
      label: _("Go");

      section {
        item {
          label: _("Goto…");
          action: "win.mash-send-key";
          target: "ctrl+alt+shift+g";
          accel: "<Control><Alt><Shift>g";
        }
      }

      section {
        item {
          label: _("Previous Workspace");
          action: "win.mash-send-key";
          target: "ctrl+alt+shift+bracket_left";
          accel: "<Control><Alt><Shift>bracketleft";
        }

        item {
          label: _("Next Workspace");
          action: "win.mash-send-key";
          target: "ctrl+alt+shift+bracket_right";
          accel: "<Control><Alt><Shift>bracketright";
        }

        item {
          label: _("Previous Tab");
          action: "win.mash-send-key";
          target: "ctrl+shift+tab";
          accel: "<Control><Shift>Tab";
        }

        item {
          label: _("Next Tab");
          action: "win.mash-send-key";
          target: "ctrl+tab";
          accel: "<Control>Tab";
        }

        item {
          label: _("Previous Pane");
          action: "win.mash-send-key";
          target: "ctrl+alt+bracket_left";
          accel: "<Control><Alt>bracketleft";
        }

        item {
          label: _("Next Pane");
          action: "win.mash-send-key";
          target: "ctrl+alt+bracket_right";
          accel: "<Control><Alt>bracketright";
        }

        item {
          label: _("Previous Agent");
          action: "win.mash-send-key";
          target: "ctrl+shift+arrow_up";
          accel: "<Control><Shift>Up";
        }

        item {
          label: _("Next Agent");
          action: "win.mash-send-key";
          target: "ctrl+shift+arrow_down";
          accel: "<Control><Shift>Down";
        }
      }

      section {
        item {
          label: _("Open Notification Target");
          action: "win.mash-send-key";
          target: "ctrl+alt+y";
          accel: "<Control><Alt>y";
        }
      }
    }

    submenu {
      label: _("Tools");

      section {
        item {
          label: _("Command Palette…");
          action: "win.mash-send-key";
          target: "ctrl+shift+p";
          accel: "<Control><Shift>p";
        }

        item {
          label: _("File Finder…");
          action: "win.mash-send-key";
          target: "ctrl+alt+p";
          accel: "<Control><Alt>p";
        }

        item {
          label: _("Source Control");
          action: "win.mash-send-key";
          target: "ctrl+shift+g";
          accel: "<Control><Shift>g";
        }

        item {
          label: _("Session Search…");
          action: "win.mash-send-key";
          target: "ctrl+alt+shift+l";
          accel: "<Control><Alt><Shift>l";
        }

        item {
          label: _("Snippets…");
          action: "win.mash-send-key";
          target: "ctrl+alt+shift+p";
          accel: "<Control><Alt><Shift>p";
        }

        item {
          label: _("Container Status");
          action: "win.mash-send-key";
          target: "ctrl+shift+o";
          accel: "<Control><Shift>o";
        }

        item {
          label: _("Plugin Manager");
          action: "win.mash-send-key";
          target: "ctrl+shift+x";
          accel: "<Control><Shift>x";
        }
      }

      section {
        item {
          label: _("Fork Agent from Message…");
          action: "win.mash-send-key";
          target: "ctrl+alt+shift+y";
          accel: "<Control><Alt><Shift>y";
        }
      }
    }
  }

  section {
    item {
      label: _("Settings…");
      action: "win.mash-send-key";
      target: "ctrl+,";
      accel: "<Control>comma";
    }

    item {
      label: _("Reload Configuration");
      action: "win.mash-reload";
      accel: "<Control><Shift>comma";
    }

    item {
      label: _("Detach");
      action: "win.mash-send-key";
      target: "ctrl+alt+u";
      accel: "<Control><Alt>u";
    }
  }

  section {
    item {
      label: _("Mash Help");
      action: "win.mash-send-key";
      target: "ctrl+shift+i";
      accel: "<Control><Shift>i";
    }

    item {
      label: _("About Mash Terminal");
      action: "win.about";
    }

    item {
      label: _("Quit");
      action: "app.quit";
    }
  }
}

// Mash: the same menu for the Native keymap; window.zig picks one from the
// mash-keybindings config.
menu main_menu_native {
  section {
    item {
      label: _("Copy");
      action: "win.copy";
    }

    item {
      label: _("Paste");
      action: "win.paste";
    }
  }

  section {
    item {
      label: _("Close Window");
      action: "win.close";
    }
  }

  section {
    item {
      label: _("Clear");
      action: "win.clear";
    }

    item {
      label: _("Reset");
      action: "win.reset";
    }
  }

  // Mash: Herdr commands in the Native keymap. Each item sends Herdr's stock
  // Ctrl+B prefix key, or Mash's keys.native.toml prefix key, as a sequence
  // (mash_send_key "ctrl+b>n"). A GTK accel holds one chord, so the sequence
  // is shown at the end of the label instead. Items for actions Herdr has no
  // stock key for (workspace and agent cycling, removing a worktree) are left
  // out rather than shown with a key that does nothing.
  section {
    submenu {
      label: _("File");

      section {
        item {
          label: _("New Dev Tab  ·  Ctrl+B t");
          action: "win.mash-send-key";
          target: "ctrl+b>t";
        }

        item {
          label: _("New Agent Tab  ·  Ctrl+B a");
          action: "win.mash-send-key";
          target: "ctrl+b>a";
        }

        item {
          label: _("New Review Tab  ·  Ctrl+B V");
          action: "win.mash-send-key";
          target: "ctrl+b>shift+v";
        }

        item {
          label: _("New Shell Tab  ·  Ctrl+B C");
          action: "win.mash-send-key";
          target: "ctrl+b>shift+c";
        }
      }

      section {
        item {
          label: _("New Workspace…  ·  Ctrl+B N");
          action: "win.mash-send-key";
          target: "ctrl+b>shift+n";
        }

        item {
          label: _("New Worktree…  ·  Ctrl+B G");
          action: "win.mash-send-key";
          target: "ctrl+b>shift+g";
        }

        item {
          label: _("Workspace Picker…  ·  Ctrl+B F");
          action: "win.mash-send-key";
          target: "ctrl+b>shift+f";
        }
      }

      section {
        item {
          label: _("Close Pane  ·  Ctrl+B x");
          action: "win.mash-send-key";
          target: "ctrl+b>x";
        }

        item {
          label: _("Close Tab  ·  Ctrl+B X");
          action: "win.mash-send-key";
          target: "ctrl+b>shift+x";
        }

        item {
          label: _("Close Workspace  ·  Ctrl+B D");
          action: "win.mash-send-key";
          target: "ctrl+b>shift+d";
        }

      }
    }

    submenu {
      label: _("Edit");

      section {
        item {
          label: _("Annotate Selection  ·  Ctrl+B i");
          action: "win.mash-send-key";
          target: "ctrl+b>i";
        }

        item {
          label: _("Paste Annotations into Agent  ·  Ctrl+B I");
          action: "win.mash-send-key";
          target: "ctrl+b>shift+i";
        }

        item {
          label: _("Manage Annotations  ·  Ctrl+B m");
          action: "win.mash-send-key";
          target: "ctrl+b>m";
        }
      }

      section {
        item {
          label: _("Pick Link or ID  ·  Ctrl+B u");
          action: "win.mash-send-key";
          target: "ctrl+b>u";
        }
      }
    }

    submenu {
      label: _("View");

      section {
        item {
          label: _("Toggle Sidebar  ·  Ctrl+B b");
          action: "win.mash-send-key";
          target: "ctrl+b>b";
        }

        item {
          label: _("Zoom Pane  ·  Ctrl+B z");
          action: "win.mash-send-key";
          target: "ctrl+b>z";
        }
      }

      section {
        item {
          label: _("Split Pane Right  ·  Ctrl+B v");
          action: "win.mash-send-key";
          target: "ctrl+b>v";
        }

        item {
          label: _("Split Pane Down  ·  Ctrl+B -");
          action: "win.mash-send-key";
          target: "ctrl+b>minus";
        }

        item {
          label: _("Resize Mode  ·  Ctrl+B r");
          action: "win.mash-send-key";
          target: "ctrl+b>r";
        }
      }
    }

    submenu {
      label: _("Go");

      section {
        item {
          label: _("Goto…  ·  Ctrl+B g");
          action: "win.mash-send-key";
          target: "ctrl+b>g";
        }
      }

      section {


        item {
          label: _("Previous Tab  ·  Ctrl+B p");
          action: "win.mash-send-key";
          target: "ctrl+b>p";
        }

        item {
          label: _("Next Tab  ·  Ctrl+B n");
          action: "win.mash-send-key";
          target: "ctrl+b>n";
        }

        item {
          label: _("Previous Pane  ·  Ctrl+B Shift+Tab");
          action: "win.mash-send-key";
          target: "ctrl+b>shift+tab";
        }

        item {
          label: _("Next Pane  ·  Ctrl+B Tab");
          action: "win.mash-send-key";
          target: "ctrl+b>tab";
        }


      }

      section {
        item {
          label: _("Open Notification Target  ·  Ctrl+B o");
          action: "win.mash-send-key";
          target: "ctrl+b>o";
        }
      }
    }

    submenu {
      label: _("Tools");

      section {
        item {
          label: _("Command Palette…  ·  Ctrl+B ;");
          action: "win.mash-send-key";
          target: "ctrl+b>semicolon";
        }

        item {
          label: _("File Finder…  ·  Ctrl+B f");
          action: "win.mash-send-key";
          target: "ctrl+b>f";
        }

        item {
          label: _("Source Control  ·  Ctrl+B y");
          action: "win.mash-send-key";
          target: "ctrl+b>y";
        }

        item {
          label: _("Session Search…  ·  Ctrl+B E");
          action: "win.mash-send-key";
          target: "ctrl+b>shift+e";
        }

        item {
          label: _("Snippets…  ·  Ctrl+B S");
          action: "win.mash-send-key";
          target: "ctrl+b>shift+s";
        }

        item {
          label: _("Container Status  ·  Ctrl+B O");
          action: "win.mash-send-key";
          target: "ctrl+b>shift+o";
        }

        item {
          label: _("Plugin Manager  ·  Ctrl+B U");
          action: "win.mash-send-key";
          target: "ctrl+b>shift+u";
        }
      }

      section {
        item {
          label: _("Fork Agent from Message…  ·  Ctrl+B Y");
          action: "win.mash-send-key";
          target: "ctrl+b>shift+y";
        }
      }
    }
  }

  section {
    item {
      label: _("Settings…  ·  Ctrl+B s");
      action: "win.mash-send-key";
      target: "ctrl+b>s";
    }

    item {
      label: _("Reload Configuration  ·  Ctrl+B R");
      action: "win.mash-reload";
    }

    item {
      label: _("Detach  ·  Ctrl+B q");
      action: "win.mash-send-key";
      target: "ctrl+b>q";
    }
  }

  section {
    item {
      label: _("Mash Help  ·  Ctrl+B ?");
      action: "win.mash-send-key";
      target: "ctrl+b>shift+slash";
    }

    item {
      label: _("About Mash Terminal");
      action: "win.about";
    }

    item {
      label: _("Quit");
      action: "app.quit";
    }
  }
}
